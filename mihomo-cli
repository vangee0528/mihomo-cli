#!/usr/bin/env bash
# ==============================================================================
# mihomo-cli - 简洁高效的 Mihomo / Clash 终端可视化节点与连接管理器
# 依赖: bash (>=4), curl, jq, column
# ==============================================================================

VERSION="1.0.1"

# 默认配置（可通过环境变量或参数覆盖）
DEFAULT_API="http://127.0.0.1:9090"
DEFAULT_TEST_URL="http://cp.cloudflare.com/generate_204"
DEFAULT_TIMEOUT="2500"

API="${MIHOMO_API:-$DEFAULT_API}"
SECRET="${MIHOMO_SECRET:-}"
TEST_URL="${MIHOMO_TEST_URL:-$DEFAULT_TEST_URL}"
TIMEOUT_MS="${MIHOMO_TIMEOUT:-$DEFAULT_TIMEOUT}"
TARGET_GROUP="${MIHOMO_GROUP:-}"

# 颜色与样式定义
ESC="\033["
RESET="${ESC}0m"
BOLD="${ESC}1m"
DIM="${ESC}2m"
ITALIC="${ESC}3m"
UNDERLINE="${ESC}4m"
REVERSE="${ESC}7m"

# 前景色
BLACK="${ESC}30m"
RED="${ESC}31m"
GREEN="${ESC}32m"
YELLOW="${ESC}33m"
BLUE="${ESC}34m"
MAGENTA="${ESC}35m"
CYAN="${ESC}36m"
WHITE="${ESC}37m"

# 背景色
BG_BLUE="${ESC}44m"
BG_CYAN="${ESC}46m"
BG_DARK="${ESC}48;5;236m"
BG_SELECT="${ESC}48;5;24m"

# 终端清理标志
CLEANED_UP=0

# ==============================================================================
# 工具函数
# ==============================================================================

url_encode() {
  local str="$1"
  jq -rn --arg x "$str" '$x|@uri'
}

api_req() {
  local method="$1"
  local path="$2"
  shift 2
  local header_args=()
  local proxy_args=()
  if [[ -n "$SECRET" ]]; then
    header_args+=(-H "Authorization: Bearer $SECRET")
  fi
  # 本地控制器不能再次走正在管理的代理，避免代理环境变量造成回环。
  if [[ "$API" =~ ^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?(/|$) ]]; then
    proxy_args+=(--noproxy '*')
  fi

  curl -sS -m 8 -X "$method" "${API}${path}" "${header_args[@]}" "${proxy_args[@]}" "$@"
}

check_api() {
  local res
  res=$(api_req GET "/version" 2>/dev/null || true)
  if [[ -z "$res" || "$res" != *"version"* ]]; then
    return 1
  fi
  return 0
}

format_bytes() {
  local b="${1:-0}"
  if (( b < 1024 )); then
    echo "${b} B"
  elif (( b < 1048576 )); then
    echo "$(( b / 1024 )) KB"
  elif (( b < 1073741824 )); then
    local mb=$(( b * 10 / 1048576 ))
    echo "$(( mb / 10 )).$(( mb % 10 )) MB"
  else
    local gb=$(( b * 100 / 1073741824 ))
    echo "$(( gb / 100 )).$(( (gb % 100) / 10 ))$(( gb % 10 )) GB"
  fi
}

# ==============================================================================
# Mihomo 数据获取与操作
# ==============================================================================

get_config_info() {
  api_req GET "/configs"
}

get_proxies_data() {
  api_req GET "/proxies"
}

get_connections_data() {
  api_req GET "/connections"
}

set_proxy_mode() {
  local new_mode="$1"
  api_req PATCH "/configs" -H "Content-Type: application/json" -d "{\"mode\":\"$new_mode\"}" >/dev/null
}

switch_node() {
  local group="$1"
  local node="$2"
  local enc_grp
  enc_grp=$(url_encode "$group")
  local payload
  payload=$(jq -n --arg name "$node" '{"name": $name}')
  api_req PUT "/proxies/$enc_grp" -H "Content-Type: application/json" -d "$payload"
}

close_all_connections() {
  api_req DELETE "/connections" >/dev/null
}

delay_request() {
  local path="$1"
  local kind="$2"
  local response body http_code error_message request_timeout curl_code

  # 加上控制器响应余量；--timeout 大于 8 秒时不能被固定的 curl 超时截断。
  request_timeout=$(( (TIMEOUT_MS + 999) / 1000 + 3 ))
  if response=$(api_req GET "$path" --connect-timeout 3 -m "$request_timeout" -w $'\n%{http_code}' 2>&1); then
    :
  else
    curl_code=$?
    response="${response//$'\n'/ }"
    response="${response//$'\r'/ }"
    printf '测速请求失败 (curl %s): %.240s\n' "$curl_code" "$response" >&2
    return 1
  fi

  http_code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ ! "$http_code" =~ ^2[0-9][0-9]$ ]]; then
    error_message=$(printf '%s' "$body" | jq -r '
      if type == "object" then (.message // .error // empty) | select(type == "string")
      else empty end
    ' 2>/dev/null || true)
    error_message="${error_message//$'\n'/ }"
    error_message="${error_message//$'\r'/ }"
    printf '测速请求失败 (HTTP %s): %.240s\n' "$http_code" "${error_message:-控制器未返回可用的错误详情}" >&2
    return 1
  fi

  if [[ "$kind" == "group" ]]; then
    if ! printf '%s' "$body" | jq -e '
      type == "object" and all(.[]; type == "number" and . >= 0 and floor == .)
    ' >/dev/null 2>&1; then
      printf '测速请求失败: 批量延迟响应不是有效的节点延迟映射\n' >&2
      return 1
    fi
  else
    if ! printf '%s' "$body" | jq -e '
      type == "object" and (.delay | type == "number" and . >= 0 and floor == .)
    ' >/dev/null 2>&1; then
      printf '测速请求失败: 单节点响应没有有效的 delay 值\n' >&2
      return 1
    fi
  fi

  printf '%s\n' "$body"
}

validate_test_settings() {
  if [[ ! "$TIMEOUT_MS" =~ ^[1-9][0-9]{0,8}$ ]]; then
    printf '测速超时必须是正整数毫秒\n' >&2
    return 1
  fi
  if [[ ! "$TEST_URL" =~ ^https?://[^[:space:]]+$ ]]; then
    printf '测速地址必须是 HTTP 或 HTTPS URL\n' >&2
    return 1
  fi
}

delay_for_node() {
  local delay_map="$1"
  local node="$2"
  # 必须保持输入为延迟映射，不能用 "$node | in(.)" 将上下文变为字符串。
  printf '%s' "$delay_map" | jq -er --arg n "$node" '
    if type != "object" then error("invalid delay map")
    else .[$n] as $delay |
      if ($delay | type) == "number" and $delay > 0 then $delay else 999999 end
    end
  '
}

test_group_delay() {
  local group="$1"
  validate_test_settings || return 1
  local enc_grp
  enc_grp=$(url_encode "$group")
  local enc_url
  enc_url=$(url_encode "$TEST_URL")
  delay_request "/group/${enc_grp}/delay?url=${enc_url}&timeout=${TIMEOUT_MS}" group
}

test_single_delay() {
  local node="$1"
  validate_test_settings || return 1
  local enc_node
  enc_node=$(url_encode "$node")
  local enc_url
  enc_url=$(url_encode "$TEST_URL")
  delay_request "/proxies/${enc_node}/delay?url=${enc_url}&timeout=${TIMEOUT_MS}" single
}

# 获取所有可用策略组列表
get_all_selector_groups() {
  local json="$1"
  echo "$json" | jq -r '
    .proxies | to_entries
    | map(select(.value.all != null and (.value.type == "Selector" or .value.type == "URLTest" or .value.type == "Fallback")))
    | map(.key)
    | .[]
  '
}

# 自动选择最合适的目标策略组
pick_best_group() {
  local json="$1"
  local groups
  mapfile -t groups < <(get_all_selector_groups "$json")
  if [[ ${#groups[@]} -eq 0 ]]; then
    echo ""
    return
  fi

  # 优先匹配常见名称
  for g in "${groups[@]}"; do
    if [[ "$g" == "🚀 节点选择" || "$g" == "节点选择" || "$g" == "PROXIES" || "$g" == "Proxy" || "$g" == "PROXY" ]]; then
      echo "$g"
      return
    fi
  done

  # 其次选择节点数最多的组（排除 GLOBAL，除非只有 GLOBAL）
  local best=""
  local max_count=-1
  for g in "${groups[@]}"; do
    if [[ "$g" == "GLOBAL" && ${#groups[@]} -gt 1 ]]; then
      continue
    fi
    local cnt
    cnt=$(echo "$json" | jq -r --arg g "$g" '(.proxies[$g].all | length) // 0')
    if (( cnt > max_count )); then
      max_count=$cnt
      best="$g"
    fi
  done

  if [[ -n "$best" ]]; then
    echo "$best"
  else
    echo "${groups[0]}"
  fi
}

# ==============================================================================
# 非交互式 CLI 子命令
# ==============================================================================

cmd_status() {
  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    echo "请检查 Mihomo 是否已启动，或使用 -c 指定控制器地址。" >&2
    exit 1
  fi

  local ver_json cfg_json conn_json proxies_json
  ver_json=$(api_req GET "/version")
  cfg_json=$(get_config_info)
  conn_json=$(get_connections_data)
  proxies_json=$(get_proxies_data)

  local version mode port conns up down best_grp current_node
  version=$(echo "$ver_json" | jq -r .version)
  mode=$(echo "$cfg_json" | jq -r .mode)
  port=$(echo "$cfg_json" | jq -r '.["mixed-port"] // .port')
  conns=$(echo "$conn_json" | jq '(.connections | length) // 0')
  up=$(echo "$conn_json" | jq -r '.uploadTotal // 0')
  down=$(echo "$conn_json" | jq -r '.downloadTotal // 0')

  best_grp="${TARGET_GROUP:-$(pick_best_group "$proxies_json")}"
  current_node=$(echo "$proxies_json" | jq -r --arg g "$best_grp" '.proxies[$g].now // "无"')

  echo -e "${BOLD}Mihomo 代理状态${RESET}"
  echo -e "  版本:       ${GREEN}${version}${RESET}"
  echo -e "  控制器:     ${CYAN}${API}${RESET}"
  echo -e "  代理端口:   ${YELLOW}${port}${RESET}"
  echo -e "  运行模式:   ${BOLD}${MAGENTA}${mode}${RESET} (rule 规则 / global 全局 / direct 直连)"
  echo -e "  当前策略组: ${BLUE}${best_grp}${RESET}"
  echo -e "  在用节点:   ${GREEN}${BOLD}${current_node}${RESET}"
  echo -e "  活跃连接:   ${conns} 个"
  echo -e "  上传流量:   $(format_bytes "$up")"
  echo -e "  下载流量:   $(format_bytes "$down")"
}

cmd_mode() {
  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    exit 1
  fi

  local target="$1"
  if [[ -z "$target" ]]; then
    local cur_mode
    cur_mode=$(get_config_info | jq -r .mode)
    echo "$cur_mode"
    return
  fi

  case "$target" in
    rule|global|direct)
      set_proxy_mode "$target"
      echo -e "${GREEN}✔ 成功将代理模式切换为: ${BOLD}$target${RESET}"
      ;;
    *)
      echo -e "${RED}错误: 不支持的模式 '$target'。可选模式: rule, global, direct${RESET}" >&2
      exit 1
      ;;
  esac
}

cmd_list() {
  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    exit 1
  fi

  local proxies_json
  proxies_json=$(get_proxies_data)
  local group="${TARGET_GROUP:-$(pick_best_group "$proxies_json")}"

  if [[ -z "$group" ]]; then
    echo -e "${RED}未找到策略组${RESET}" >&2
    exit 1
  fi

  local now_node
  now_node=$(echo "$proxies_json" | jq -r --arg g "$group" '.proxies[$g].now // ""')

  echo -e "${BOLD}策略组: ${BLUE}$group${RESET} ${DIM}(当前节点: ${GREEN}$now_node${RESET}${DIM})${RESET}\n"

  echo "$proxies_json" | jq -r --arg g "$group" '
    .proxies as $p |
    ($p[$g].all // [])[] |
    [
      (if . == $p[$g].now then "* " else "  " end),
      .,
      ($p[.].type // "-"),
      (if ($p[.].history | length) > 0 then
         (if $p[.].history[-1].delay > 0 then ($p[.].history[-1].delay|tostring) + " ms"
          elif $p[.].history[-1].delay == 0 then "Timeout"
          else "未测速" end)
       else "未测速" end)
    ] | @tsv
  ' | column -t -s $'\t'
}

cmd_test() {
  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    exit 1
  fi

  local proxies_json
  proxies_json=$(get_proxies_data)
  local group="${TARGET_GROUP:-$(pick_best_group "$proxies_json")}"

  if [[ -z "$group" ]]; then
    echo -e "${RED}未找到策略组${RESET}" >&2
    exit 1
  fi

  echo -e "${CYAN}⚡ 正在并行扫描并测速策略组 [${BLUE}$group${CYAN}] 中的所有节点 (超时: ${TIMEOUT_MS}ms)...${RESET}"
  local delay_res
  if ! delay_res=$(test_group_delay "$group"); then
    return 1
  fi

  echo -e "\n${BOLD}测速结果 (按延迟升序排序):${RESET}\n"

  # 提取延迟并按延迟从小到大排序
  echo "$proxies_json" | jq -r --arg g "$group" --argjson delays "$delay_res" '
    .proxies as $p |
    ($p[$g].all // []) |
    map({
      name: .,
      is_now: (. == $p[$g].now),
      type: ($p[.].type // "-"),
      delay: (if ($delays[.] // 0) > 0 then $delays[.] else 999999 end)
    }) |
    sort_by(.delay) |
    .[] |
    [
      (if .is_now then "* " else "  " end),
      .name,
      .type,
      (if .delay < 999999 and .delay > 0 then (.delay|tostring) + " ms"
       elif .delay == 999999 then "Timeout"
       else "Error" end)
    ] | @tsv
  ' | column -t -s $'\t'
}

cmd_set() {
  local node="$1"
  if [[ -z "$node" ]]; then
    echo -e "${RED}错误: 请指定要切换的节点名称${RESET}" >&2
    echo "用法: mihomo-cli set <节点名称>" >&2
    exit 1
  fi

  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    exit 1
  fi

  local proxies_json
  proxies_json=$(get_proxies_data)
  local group="${TARGET_GROUP:-$(pick_best_group "$proxies_json")}"

  local exists
  exists=$(echo "$proxies_json" | jq -r --arg g "$group" --arg n "$node" '
    if (.proxies[$g].all // []) | index($n) then "1" else "0" end
  ')

  if [[ "$exists" != "1" ]]; then
    echo -e "${RED}错误: 策略组 [${group}] 中不存在节点 '${node}'${RESET}" >&2
    exit 1
  fi

  switch_node "$group" "$node"
  echo -e "${GREEN}✔ 成功切换策略组 [${BLUE}$group${GREEN}] 节点为: ${BOLD}$node${RESET}"

  if [[ "${2:-}" == "--close-conns" || "${CLOSE_CONNS_ON_SWITCH:-0}" == "1" ]]; then
    close_all_connections
    echo -e "${CYAN}✔ 已关闭所有旧连接${RESET}"
  fi
}

cmd_env() {
  local action="${1:-on}"
  local cfg_json
  cfg_json=$(get_config_info 2>/dev/null || true)
  local port=7890
  if [[ -n "$cfg_json" ]]; then
    port=$(echo "$cfg_json" | jq -r '.["mixed-port"] // .port // 7890')
  fi

  case "$action" in
    on)
      cat <<EOF
export http_proxy=http://127.0.0.1:${port}
export https_proxy=http://127.0.0.1:${port}
export all_proxy=socks5://127.0.0.1:${port}
export HTTP_PROXY=http://127.0.0.1:${port}
export HTTPS_PROXY=http://127.0.0.1:${port}
export ALL_PROXY=socks5://127.0.0.1:${port}
# 提示: 执行 eval \$(mihomo-cli env on) 即可快速在当前终端生效
EOF
      ;;
    off)
      cat <<EOF
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
# 提示: 执行 eval \$(mihomo-cli env off) 即可快速取消当前终端代理
EOF
      ;;
    *)
      echo "用法: mihomo-cli env [on|off]" >&2
      ;;
  esac
}

cmd_close_conns() {
  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    exit 1
  fi
  close_all_connections
  echo -e "${GREEN}✔ 已成功清理并关闭所有活跃代理连接${RESET}"
}

cmd_ip() {
  local cfg_json port
  cfg_json=$(get_config_info 2>/dev/null || true)
  port=$(echo "$cfg_json" | jq -r '.["mixed-port"] // .port // 7890' 2>/dev/null || echo 7890)

  echo -e "${CYAN}⚡ 正在通过代理端口 ${YELLOW}${port}${CYAN} 查询出口 IP 与地理位置...${RESET}\n"
  local res
  res=$(curl -x "http://127.0.0.1:${port}" -m 6 -s "http://ip-api.com/json" 2>/dev/null || true)
  if [[ -z "$res" || "$res" != *"query"* ]]; then
    res=$(curl -x "http://127.0.0.1:${port}" -m 6 -s "https://ipinfo.io/json" 2>/dev/null || true)
  fi

  if [[ -n "$res" && ( "$res" == *"country"* || "$res" == *"query"* ) ]]; then
    echo "$res" | jq -r '
      "  出口 IP:   \u001b[1;32m" + (.query // .ip // "未知") + "\u001b[0m\n" +
      "  地区/国家: \u001b[1;36m" + (.country // "未知") + " " + (.city // "") + " (" + (.countryCode // "") + ")\u001b[0m\n" +
      "  运营商:    " + (.isp // .org // "未知") + "\n" +
      "  所在时区:  " + (.timezone // "未知")
    '
  else
    echo -e "${RED}✖ 查询失败，请确认代理节点是否连通。${RESET}" >&2
    exit 1
  fi
}


# ==============================================================================
# 交互式 TUI 界面
# ==============================================================================

cleanup_tui() {
  if (( CLEANED_UP == 0 )); then
    CLEANED_UP=1
    # 恢复光标并切回主屏幕
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
    stty echo icanon 2>/dev/null || true
  fi
}

read_key() {
  local key=""
  local rest=""
  IFS= read -rsn1 key 2>/dev/null || return 1
  if [[ "$key" == $'\x1b' ]]; then
    read -rsn1 -t 0.05 rest 2>/dev/null || true
    if [[ "$rest" == "[" || "$rest" == "O" ]]; then
      key+="$rest"
      read -rsn1 -t 0.05 rest 2>/dev/null || true
      key+="$rest"
      if [[ "$rest" =~ [0-9] ]]; then
        read -rsn1 -t 0.05 rest 2>/dev/null || true
        key+="$rest"
      fi
    elif [[ -n "$rest" ]]; then
      key+="$rest"
    fi
  fi
  printf "%s" "$key"
}

tui_main() {
  # 如果不是交互式终端环境或缺少终端支持（例如管道或 dumb 终端），降级输出状态与列表
  if [[ ! -t 0 || "$TERM" == "dumb" || -z "$TERM" ]]; then
    cmd_status
    echo ""
    cmd_list
    return
  fi

  if ! check_api; then
    echo -e "${RED}错误: 无法连接至 Mihomo 控制器 (${API})${RESET}" >&2
    echo "请确认 Mihomo 服务是否在运行，或指定正确的 API 地址。" >&2
    echo "使用环境变量: MIHOMO_API=http://127.0.0.1:9090 ./mihomo-cli" >&2
    exit 1
  fi

  # 初始化终端
  trap cleanup_tui INT TERM EXIT
  stty -echo -icanon min 1 time 0 2>/dev/null || true
  tput smcup 2>/dev/null || true
  tput civis 2>/dev/null || true
  trap 'draw_ui' WINCH

  # 状态变量
  local active_group=""
  local all_groups=()
  local current_mode="rule"
  local current_port="7890"
  local mihomo_ver=""
  local active_conns=0
  local total_up=0
  local total_down=0

  # 节点数据 (存储为数组，每项是 TSV: name \t type \t delay \t is_active)
  local raw_nodes=()
  local filtered_nodes=()
  local node_count=0

  local selected_idx=0
  local scroll_offset=0
  local sort_mode="default" # default, delay, name
  local search_query=""
  local status_msg="按 't' 自动测速扫描全部节点 | 'm' 切换模式 | 回车 切换节点"
  local status_msg_color="$CYAN"

  # 加载基础信息
  refresh_data() {
    local ver_json cfg_json conn_json proxies_json
    ver_json=$(api_req GET "/version" 2>/dev/null || echo "{}")
    cfg_json=$(get_config_info 2>/dev/null || echo "{}")
    conn_json=$(get_connections_data 2>/dev/null || echo "{}")
    proxies_json=$(get_proxies_data 2>/dev/null || echo "{}")

    mihomo_ver=$(echo "$ver_json" | jq -r .version 2>/dev/null || echo "-")
    current_mode=$(echo "$cfg_json" | jq -r .mode 2>/dev/null || echo "rule")
    current_port=$(echo "$cfg_json" | jq -r '.["mixed-port"] // .port // 7890' 2>/dev/null || echo "7890")
    active_conns=$(echo "$conn_json" | jq '(.connections | length) // 0' 2>/dev/null || echo "0")
    total_up=$(echo "$conn_json" | jq -r '.uploadTotal // 0' 2>/dev/null || echo "0")
    total_down=$(echo "$conn_json" | jq -r '.downloadTotal // 0' 2>/dev/null || echo "0")

    mapfile -t all_groups < <(get_all_selector_groups "$proxies_json")
    if [[ -z "$active_group" ]]; then
      active_group="${TARGET_GROUP:-$(pick_best_group "$proxies_json")}"
    fi

    # 提取当前策略组的节点列表
    mapfile -t raw_nodes < <(
      echo "$proxies_json" | jq -r --arg grp "$active_group" '
        .proxies as $p |
        ($p[$grp].all // []) |
        map({
          name: .,
          type: ($p[.].type // "-"),
          delay: (
            if ($p[.].history | length) > 0 then
              (if $p[.].history[-1].delay > 0 then $p[.].history[-1].delay
               elif $p[.].history[-1].delay == 0 then 999999
               else -1 end)
            else -1 end
          ),
          is_active: (if . == $p[$grp].now then 1 else 0 end)
        }) |
        .[] |
        [.name, .type, (.delay|tostring), (.is_active|tostring)] |
        @tsv
      '
    )

    apply_filter_and_sort
  }

  apply_filter_and_sort() {
    filtered_nodes=()
    local item name type delay is_act
    for item in "${raw_nodes[@]}"; do
      IFS=$'\t' read -r name type delay is_act <<< "$item"
      if [[ -n "$search_query" ]]; then
        local lower_name lower_query
        lower_name=$(echo "$name" | tr '[:upper:]' '[:lower:]')
        lower_query=$(echo "$search_query" | tr '[:upper:]' '[:lower:]')
        if [[ "$lower_name" != *"$lower_query"* ]]; then
          continue
        fi
      fi
      filtered_nodes+=("$item")
    done

    # 排序
    if [[ "$sort_mode" == "delay" ]]; then
      # 延迟排序：delay > 0 升序，-1 和 999999(超时) 放后面
      mapfile -t filtered_nodes < <(
        for item in "${filtered_nodes[@]}"; do
          echo "$item"
        done | awk -F'\t' '{
          d = $3 + 0;
          # -1(未测速) 给权重 999998, 999999(超时) 给权重 999999
          rank = (d > 0 && d < 999999) ? d : (d == -1 ? 999998 : 999999);
          printf "%08d\t%s\n", rank, $0;
        }' | sort -n | cut -f2-
      )
    elif [[ "$sort_mode" == "name" ]]; then
      mapfile -t filtered_nodes < <(
        for item in "${filtered_nodes[@]}"; do
          echo "$item"
        done | sort -t$'\t' -k1,1
      )
    fi

    node_count=${#filtered_nodes[@]}
    if (( selected_idx >= node_count )); then
      selected_idx=$(( node_count > 0 ? node_count - 1 : 0 ))
    fi
    if (( selected_idx < 0 )); then
      selected_idx=0
    fi
  }

  draw_ui() {
    local term_lines term_cols
    term_lines=$(tput lines 2>/dev/null || echo 24)
    term_cols=$(tput cols 2>/dev/null || echo 80)

    # 计算列表展示高度
    local header_lines=6
    local footer_lines=4
    local page_size=$(( term_lines - header_lines - footer_lines ))
    if (( page_size < 3 )); then
      page_size=3
    fi

    # 调整滚动偏移
    if (( selected_idx < scroll_offset )); then
      scroll_offset=$selected_idx
    elif (( selected_idx >= scroll_offset + page_size )); then
      scroll_offset=$(( selected_idx - page_size + 1 ))
    fi

    # 准备批量渲染缓冲
    local buf=""
    # 移动到屏幕左上角并清除
    buf+="${ESC}H${ESC}2J"

    # --- Header ---
    local mode_badge=""
    case "$current_mode" in
      rule)   mode_badge="${BG_BLUE}${WHITE}${BOLD} RULE 规则模式 ${RESET}" ;;
      global) mode_badge="${BG_CYAN}${BLACK}${BOLD} GLOBAL 全局模式 ${RESET}" ;;
      direct) mode_badge="${RED}${BOLD}[ DIRECT 直连模式 ]${RESET}" ;;
      *)      mode_badge="${MAGENTA}${BOLD}[ $current_mode ]${RESET}" ;;
    esac

    # 找出当前策略组中在用的节点名称
    local current_active_node="未知"
    for item in "${raw_nodes[@]}"; do
      IFS=$'\t' read -r name type delay is_act <<< "$item"
      if [[ "$is_act" == "1" ]]; then
        current_active_node="$name"
        break
      fi
    done

    buf+="${BOLD}${CYAN}⚡ Mihomo CLI${RESET} ${DIM}v${VERSION}${RESET}  ${GREEN}● 运行中${RESET} ${DIM}(Mihomo ${mihomo_ver})${RESET}    ${mode_badge}\n"
    buf+="  ${DIM}接口:${RESET} ${API}  ${DIM}端口:${RESET} ${YELLOW}${current_port}${RESET}  ${DIM}连接数:${RESET} ${BOLD}${active_conns}${RESET}  ${DIM}流量:${RESET} ↑ $(format_bytes "$total_up")  ↓ $(format_bytes "$total_down")\n"
    buf+="  ${DIM}策略组:${RESET} ${BOLD}${BLUE}[${active_group}]${RESET}  ${DIM}当前在用节点:${RESET} ${GREEN}${BOLD}${current_active_node}${RESET}\n"

    # 搜索框与排序状态提示
    local sort_label="默认配置顺序"
    if [[ "$sort_mode" == "delay" ]]; then sort_label="⚡ 延迟升序"; fi
    if [[ "$sort_mode" == "name" ]]; then sort_label="🔤 名称排序"; fi

    if [[ -n "$search_query" ]]; then
      buf+="  ${YELLOW}🔍 搜索: [${search_query}]${RESET} ${DIM}(共 ${node_count} 个匹配, 排序: ${sort_label})${RESET}\n"
    else
      buf+="  ${DIM}排序:${RESET} ${sort_label}  ${DIM}(共 ${node_count} 个节点)${RESET}\n"
    fi

    buf+="${CYAN}───────────────────────────────────────────────────────────────────────────────${RESET}\n"

    # --- Node List ---
    if (( node_count == 0 )); then
      buf+="${YELLOW}  (未找到匹配的节点，按 Esc 清除搜索)${RESET}\n"
      for (( i=1; i<page_size; i++ )); do
        buf+="\n"
      done
    else
      local end_idx=$(( scroll_offset + page_size ))
      if (( end_idx > node_count )); then
        end_idx=$node_count
      fi

      for (( idx=scroll_offset; idx<end_idx; idx++ )); do
        local item="${filtered_nodes[$idx]}"
        IFS=$'\t' read -r name type delay is_act <<< "$item"

        # 延迟显示格式与颜色
        local delay_str=""
        local d_num=$(( delay + 0 ))
        if (( d_num > 0 && d_num < 999999 )); then
          if (( d_num < 200 )); then
            delay_str="${GREEN}$(printf "%4d ms" "$d_num")${RESET}"
          elif (( d_num < 500 )); then
            delay_str="${YELLOW}$(printf "%4d ms" "$d_num")${RESET}"
          else
            delay_str="${MAGENTA}$(printf "%4d ms" "$d_num")${RESET}"
          fi
        elif (( d_num == 999999 )); then
          delay_str="${RED} Timeout${RESET}"
        else
          delay_str="${DIM}  未测速${RESET}"
        fi

        # 节点类型
        local type_str="${DIM}$(printf "[%-6s]" "$type")${RESET}"

        # 激活状态图标
        local active_icon="   "
        if [[ "$is_act" == "1" ]]; then
          active_icon="${GREEN}${BOLD}[✓]${RESET}"
        else
          active_icon="${DIM}[ ]${RESET}"
        fi

        # 选中行高亮
        if (( idx == selected_idx )); then
          buf+="${REVERSE} > ${RESET} ${active_icon} ${BOLD}${name}${RESET}  ${type_str}  ${delay_str}\n"
        else
          buf+="   ${active_icon} ${name}  ${type_str}  ${delay_str}\n"
        fi
      done

      # 补齐空白行保持高度稳定
      local rendered_rows=$(( end_idx - scroll_offset ))
      for (( i=rendered_rows; i<page_size; i++ )); do
        buf+="\n"
      done
    fi

    # --- Footer ---
    buf+="${CYAN}───────────────────────────────────────────────────────────────────────────────${RESET}\n"
    buf+="  ${status_msg_color}${status_msg}${RESET}\n"
    buf+="${DIM}  [↑/↓/j/k] 移动  [Enter] 切换节点  [t] 测速全部  [p] 测速当前  [s] 排序  [m] 模式\n"
    buf+="  [g] 策略组  [c] 断开旧连接  [/] 搜索  [r] 刷新  [q] 退出${RESET}"

    printf "%b" "$buf"
  }

  # 首次拉取数据
  refresh_data

  # 主事件循环
  while true; do
    draw_ui
    local key
    if ! key=$(read_key); then
      # 终端关闭或输入 EOF 时退出，不能误当成 Enter 切换节点并断开连接。
      break
    fi

    case "$key" in
      # 方向键上 / k
      $'\x1b[A'|$'\x1bOA'|k|K)
        if (( selected_idx > 0 )); then
          ((selected_idx--))
        fi
        ;;
      # 方向键下 / j
      $'\x1b[B'|$'\x1bOB'|j|J)
        if (( selected_idx < node_count - 1 )); then
          ((selected_idx++))
        fi
        ;;
      # Page Up / Ctrl+U
      $'\x1b[5~'|$'\x15')
        local term_lines
        term_lines=$(tput lines 2>/dev/null || echo 24)
        local page_jump=$(( term_lines - 10 ))
        if (( page_jump < 1 )); then page_jump=5; fi
        selected_idx=$(( selected_idx - page_jump ))
        if (( selected_idx < 0 )); then selected_idx=0; fi
        ;;
      # Page Down / Ctrl+D
      $'\x1b[6~'|$'\x04')
        local term_lines
        term_lines=$(tput lines 2>/dev/null || echo 24)
        local page_jump=$(( term_lines - 10 ))
        if (( page_jump < 1 )); then page_jump=5; fi
        selected_idx=$(( selected_idx + page_jump ))
        if (( selected_idx >= node_count )); then
          selected_idx=$(( node_count > 0 ? node_count - 1 : 0 ))
        fi
        ;;
      # Home
      $'\x1b[H'|$'\x1b[1~')
        selected_idx=0
        ;;
      # End
      $'\x1b[F'|$'\x1b[4~')
        selected_idx=$(( node_count > 0 ? node_count - 1 : 0 ))
        ;;
      # Enter / 空格: 切换到选中节点
      ""|$' '|G)
        if (( node_count > 0 && selected_idx < node_count )); then
          local item="${filtered_nodes[$selected_idx]}"
          IFS=$'\t' read -r target_node target_type target_delay target_act <<< "$item"
          status_msg="正在切换至节点: [${target_node}]..."
          status_msg_color="$YELLOW"
          draw_ui
          switch_node "$active_group" "$target_node"
          close_all_connections
          status_msg="✔ 已成功切换至节点: [${target_node}]，并已断开旧连接"
          status_msg_color="$GREEN"
          refresh_data
        fi
        ;;
      # t: 批量扫描测速策略组内所有节点
      t|T)
        status_msg="⚡ 正在扫描策略组 [${active_group}] 全部节点延迟，请稍候..."
        status_msg_color="$YELLOW"
        draw_ui

        local delay_map
        if ! delay_map=$(test_group_delay "$active_group" 2>&1); then
          status_msg="✖ 批量测速失败: ${delay_map//$'\n'/ }"
          status_msg_color="$RED"
          continue
        fi

        # 更新 raw_nodes 中的延迟
        local updated_nodes=()
        for item in "${raw_nodes[@]}"; do
          IFS=$'\t' read -r name type delay is_act <<< "$item"
          local new_delay
          new_delay=$(delay_for_node "$delay_map" "$name")
          updated_nodes+=("${name}"$'\t'"${type}"$'\t'"${new_delay}"$'\t'"${is_act}")
        done
        raw_nodes=("${updated_nodes[@]}")

        # 测速完成后自动切换为按延迟升序查看
        sort_mode="delay"
        apply_filter_and_sort
        selected_idx=0
        status_msg="✔ 批量测速完成！已按延迟升序自动排序"
        status_msg_color="$GREEN"
        ;;
      # p: 测速当前高亮节点
      p|P)
        if (( node_count > 0 && selected_idx < node_count )); then
          local item="${filtered_nodes[$selected_idx]}"
          IFS=$'\t' read -r curr_name curr_type curr_delay curr_act <<< "$item"
          status_msg="⚡ 正在测试节点 [${curr_name}] 延迟..."
          status_msg_color="$YELLOW"
          draw_ui

          local single_res
          if ! single_res=$(test_single_delay "$curr_name" 2>&1); then
            status_msg="✖ 节点 [${curr_name}] 测速失败: ${single_res//$'\n'/ }"
            status_msg_color="$RED"
            continue
          fi
          local new_delay
          new_delay=$(printf '%s' "$single_res" | jq -r 'if .delay > 0 then .delay else 999999 end')

          # 更新节点数据
          local updated_nodes=()
          for item in "${raw_nodes[@]}"; do
            IFS=$'\t' read -r name type delay is_act <<< "$item"
            if [[ "$name" == "$curr_name" ]]; then
              updated_nodes+=("${name}"$'\t'"${type}"$'\t'"${new_delay}"$'\t'"${is_act}")
            else
              updated_nodes+=("$item")
            fi
          done
          raw_nodes=("${updated_nodes[@]}")
          apply_filter_and_sort

          if (( new_delay < 999999 )); then
            status_msg="✔ 节点 [${curr_name}] 延迟: ${new_delay} ms"
            status_msg_color="$GREEN"
          else
            status_msg="✖ 节点 [${curr_name}] 测试超时或连接失败"
            status_msg_color="$RED"
          fi
        fi
        ;;
      # s: 切换排序模式 (default -> delay -> name -> default)
      s|S)
        case "$sort_mode" in
          default) sort_mode="delay" ;;
          delay)   sort_mode="name" ;;
          name)    sort_mode="default" ;;
        esac
        apply_filter_and_sort
        status_msg="已切换排序为: $([[ "$sort_mode" == "delay" ]] && echo "延迟升序" || ([[ "$sort_mode" == "name" ]] && echo "名称" || echo "默认配置顺序"))"
        status_msg_color="$CYAN"
        ;;
      # m: 循环切换模式 (rule -> global -> direct -> rule)
      m|M)
        local next_mode="rule"
        case "$current_mode" in
          rule)   next_mode="global" ;;
          global) next_mode="direct" ;;
          direct) next_mode="rule" ;;
        esac
        set_proxy_mode "$next_mode"
        current_mode="$next_mode"
        status_msg="✔ 已切换运行模式为: ${next_mode} (rule 规则 / global 全局 / direct 直连)"
        status_msg_color="$GREEN"
        ;;
      # g: 切换策略组
      g)
        if [[ ${#all_groups[@]} -gt 1 ]]; then
          local current_grp_idx=0
          for i in "${!all_groups[@]}"; do
            if [[ "${all_groups[$i]}" == "$active_group" ]]; then
              current_grp_idx=$i
              break
            fi
          done
          local next_grp_idx=$(( (current_grp_idx + 1) % ${#all_groups[@]} ))
          active_group="${all_groups[$next_grp_idx]}"
          selected_idx=0
          scroll_offset=0
          search_query=""
          status_msg="已切换至策略组: [${active_group}]"
          status_msg_color="$CYAN"
          refresh_data
        fi
        ;;
      # c: 清除断开所有旧连接
      c|C)
        close_all_connections
        status_msg="✔ 已清理并断开所有旧的活跃代理连接"
        status_msg_color="$GREEN"
        refresh_data
        ;;
      # /: 搜索过滤
      /)
        # 临时恢复回显以输入关键字
        stty echo icanon
        tput cnorm
        printf "\n\033[K%b🔍 输入搜索关键字 (回车确认，留空清空): %b" "$YELLOW" "$RESET"
        local input_kw=""
        read -r input_kw || true
        stty -echo -icanon min 1 time 0
        tput civis
        search_query="$input_kw"
        selected_idx=0
        scroll_offset=0
        apply_filter_and_sort
        if [[ -n "$search_query" ]]; then
          status_msg="已应用搜索: [${search_query}] (匹配到 ${node_count} 个节点，按 Esc 清除)"
        else
          status_msg="已清除搜索过滤"
        fi
        status_msg_color="$CYAN"
        ;;
      # Esc: 清除搜索
      $'\x1b')
        if [[ -n "$search_query" ]]; then
          search_query=""
          apply_filter_and_sort
          status_msg="已重置搜索"
          status_msg_color="$CYAN"
        fi
        ;;
      # r: 刷新
      r|R)
        refresh_data
        status_msg="✔ 数据已刷新"
        status_msg_color="$GREEN"
        ;;
      # q: 退出
      q|Q)
        cleanup_tui
        echo -e "${GREEN}已退出 mihomo-cli。${RESET}"
        exit 0
        ;;
      *)
        # 忽略未识别按键
        ;;
    esac
  done
}

# ==============================================================================
# 帮助信息与入口处理
# ==============================================================================

show_help() {
  cat <<EOF
${BOLD}mihomo-cli${RESET} - 终端可视化 Mihomo / Clash 节点与连接管理工具 (v${VERSION})

${BOLD}用法:${RESET}
  mihomo-cli                    以可视化交互式 TUI 界面启动（支持上下键选择与回车切换）
  mihomo-cli list               列出当前策略组的所有节点和延迟
  mihomo-cli test               并行测速扫描所有节点并按延迟升序输出
  mihomo-cli set <节点名称>      直接切换至指定节点
  mihomo-cli mode [模式]        查看或切换代理模式 (rule 规则 / global 全局 / direct 直连)
  mihomo-cli status             显示当前代理运行状态、连接数及流量
  mihomo-cli close-conns        断开并清理所有活跃的代理连接
  mihomo-cli env [on|off]       输出终端代理环境变量配置 (可用于 eval \$(mihomo-cli env on))
  mihomo-cli -h, --help         显示此帮助信息

${BOLD}交互式快捷键:${RESET}
  ↑ / k, ↓ / j    上下移动光标
  Enter / 空格    切换为光标选中的节点（并自动断开旧连接）
  t               自动并发测速扫描全部节点，并按延迟升序排序
  p               单独测试当前选中节点的延迟
  s               切换排序模式 (默认顺序 -> 延迟升序 -> 名称顺序)
  m               循环切换运行模式 (Rule 规则 -> Global 全局 -> Direct 直连)
  g               切换策略组 (Selector Groups)
  c               手动断开并清理所有旧连接
  /               快速按关键字搜索过滤节点 (Esc 清除搜索)
  r               刷新数据
  q               退出程序

${BOLD}环境变量与选项:${RESET}
  -c, --controller <URL>   Mihomo 控制器 API 地址 (默认: http://127.0.0.1:9090 或 \$MIHOMO_API)
  -s, --secret <密钥>      Mihomo 控制器 Secret 密钥 (默认空 或 \$MIHOMO_SECRET)
  -g, --group <组名>       目标策略组名称 (默认自动挑选节点最多的策略组 或 \$MIHOMO_GROUP)
  --timeout <毫秒>         测速超时时间 (默认: 2500ms 或 \$MIHOMO_TIMEOUT)
  --test-url <URL>         测速地址 (默认: ${DEFAULT_TEST_URL} 或 \$MIHOMO_TEST_URL)

EOF
}

# 可供回归测试加载函数，不启动界面、不安装终端清理 trap。
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

# 解析全局参数
POSITIONAL_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--controller)
      API="$2"
      shift 2
      ;;
    -s|--secret)
      SECRET="$2"
      shift 2
      ;;
    -g|--group)
      TARGET_GROUP="$2"
      shift 2
      ;;
    --timeout)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' '--timeout 缺少毫秒参数' >&2
        exit 1
      fi
      TIMEOUT_MS="$2"
      shift 2
      ;;
    --test-url)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' '--test-url 缺少 URL 参数' >&2
        exit 1
      fi
      TEST_URL="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    -v|--version)
      echo "mihomo-cli version ${VERSION}"
      exit 0
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

set -- "${POSITIONAL_ARGS[@]}"

# 子命令调度
SUBCMD="${1:-}"

case "$SUBCMD" in
  "")
    tui_main
    ;;
  status)
    cmd_status
    ;;
  list|ls)
    cmd_list
    ;;
  test)
    cmd_test
    ;;
  set)
    shift
    cmd_set "$@"
    ;;
  mode)
    shift
    cmd_mode "$@"
    ;;
  close-conns|close)
    cmd_close_conns
    ;;
  env)
    shift
    cmd_env "$@"
    ;;
  *)
    echo -e "${RED}未知命令: $SUBCMD${RESET}" >&2
    echo "运行 'mihomo-cli --help' 查看帮助信息。" >&2
    exit 1
    ;;
esac
